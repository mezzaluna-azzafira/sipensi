# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------
# Rahasia / kredensial — RAWAN DICURI, jangan pernah di-commit.
# Catatan: .env* sudah di-ignore di atas (kunci Supabase & SUPABASE_SERVICE_ROLE_KEY
# ada di .env.local). Baris di bawah menutup jenis file rahasia lainnya.
# ------------------------------------------------------------------
*.key
*.pem
*.p12
*.pfx
*.pkcs12
*.crt
*_rsa
*_rsa.pub
*_ed25519
service-account*.json
*-service-account.json
secrets.json
.secrets/
credentials.json

# Supabase — file kerja & sementara lokal
supabase/.branches/
supabase/.temp/
supabase/.env

# ------------------------------------------------------------------
# Asisten AI — jangan dipublikasikan ke repo klien (semua jejak AI)
